{
  "name": "resolveai",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "engines": {
    "node": "24.13.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && pnpm test:types",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "local:init": "node scripts/local-init.mjs",
    "infra:up": "docker compose --env-file .env up -d --wait && node scripts/storage-init.mjs",
    "infra:down": "docker compose --env-file .env down",
    "db:migrate": "pnpm --filter @resolveai/api db:migrate",
    "db:generate": "pnpm --filter @resolveai/api db:generate",
    "db:seed": "pnpm --filter @resolveai/api db:seed",
    "queue:smoke": "pnpm --filter @resolveai/worker queue:smoke",
    "infra:load-images": "node scripts/load-local-images.mjs",
    "db:migrate:test": "node scripts/test-database.mjs",
    "test:types": "tsc --noEmit -p tsconfig.tests.json",
    "pretest": "turbo run build --filter=@resolveai/shared --filter=@resolveai/policy-engine --filter=@resolveai/paypal-client --filter=@resolveai/payment-store --filter=@resolveai/case-store --filter=@resolveai/ai-core",
    "pretest:integration": "pnpm db:generate && pnpm pretest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:integration && pnpm test:e2e",
    "db:provision-payments": "node scripts/provision-payments.mjs",
    "test:sandbox": "pnpm pretest && tsx scripts/sandbox-smoke.ts",
    "paypal:configure": "node scripts/configure-paypal.mjs",
    "db:provision-evidence": "node scripts/provision-evidence.mjs",
    "evidence:configure": "node scripts/configure-evidence.mjs",
    "scanner:up": "docker compose --env-file .env --profile scanner up -d --wait clamav",
    "scanner:load-image": "node scripts/load-clamav.mjs",
    "db:provision-ai": "node scripts/provision-ai.mjs",
    "ai:configure": "node scripts/configure-ai.mjs",
    "ai:evaluate": "pnpm pretest && node scripts/ai-evaluate.mjs",
    "ai:smoke:preview": "pnpm pretest && node scripts/ai-smoke.mjs --preview",
    "ai:smoke": "pnpm pretest && node scripts/ai-smoke.mjs",
    "ai:quality": "node scripts/ai-quality.mjs",
    "gemini:smoke:preview": "pnpm pretest && node scripts/gemini-smoke-preview.mjs --preview",
    "demo:settlement": "pnpm pretest && tsx scripts/phase6-demo.ts",
    "demo:refund-worker": "pnpm pretest && node scripts/mock-refunds.mjs",
    "check:safe": "node scripts/check-safe.mjs",
    "test:integration:safe": "pnpm pretest && vitest run --project integration tests/integration/settlement-safe.test.ts tests/integration/analytics-safe.test.ts",
    "test:e2e:safe": "playwright test tests/e2e/shell.spec.ts tests/e2e/checkout.spec.ts tests/e2e/settlement-safe.spec.ts",
    "demo:hackathon": "pnpm pretest && tsx scripts/hackathon-demo.ts",
    "demo:ai-worker": "pnpm pretest && node scripts/demo-ai.mjs",
    "demo:start": "pnpm pretest && node scripts/demo-start.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "turbo": "2.11.10",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "@eslint/js": "10.0.1",
    "prettier": "3.9.10",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "dotenv": "17.2.3",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
