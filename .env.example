# Run pnpm local:init to generate ignored development/test credentials.
# These placeholders are not usable secrets. Never commit .env or .env.test.
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001
VITE_API_BASE_URL=/api/v1
DATABASE_URL=postgresql://resolve_runtime:REPLACE_ME@localhost:5432/resolveai
MIGRATION_DATABASE_URL=postgresql://resolve_migrator:REPLACE_ME@localhost:5432/resolveai
# .env.test uses resolve_test and resolveai_test for both URLs, not the development DB.
REDIS_URL=redis://:REPLACE_ME@localhost:6379
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_SECRET
REDIS_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_SECRET
SESSION_HASH_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CSRF_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENABLE_DEV_SEED=false
DEV_SEED_PASSWORD=REPLACE_WITH_STRONG_DEVELOPMENT_ONLY_PASSWORD
LOG_LEVEL=info
WORKER_CONCURRENCY=4
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_WITH_GENERATED_LOCAL_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_GENERATED_LOCAL_SECRET
S3_QUARANTINE_BUCKET=resolveai-quarantine-local
S3_CLEAN_BUCKET=resolveai-clean-local
# Sandbox integration is optional until explicitly enabled. No production payments.
LIVE_PAYMENTS_ENABLED=false
PAYPAL_FORMAL_DISPUTES_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_STORE_RESPONSES=false
# Generated by pnpm db:provision-payments; keep private.
WORKER_DATABASE_URL=postgresql://resolve_payments:REPLACE_ME@localhost:5432/resolveai
PAYPAL_ENABLED=false
PAYPAL_TENANT_ID=
PAYPAL_ACCOUNT_KEY=demo-sandbox
WEBHOOK_PAYLOAD_ENCRYPTION_KEY=
# Opt-in manual real-Sandbox smoke; never enabled in CI.
RUN_PAYPAL_SANDBOX=false
SANDBOX_ORDER_ID=
SANDBOX_CUSTOMER_EMAIL=customer@resolveai.test
SANDBOX_CUSTOMER_PASSWORD=

# Phase 4: dedicated evidence worker; scanner is optional but downloads fail closed without it.
EVIDENCE_ENABLED=false
EVIDENCE_DATABASE_URL=postgresql://resolve_evidence:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/resolveai
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Phase 5: explicit opt-in; never put these in VITE_ variables.
AI_ENABLED=false
AI_DATABASE_URL=postgresql://resolve_ai:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/resolveai
AI_ARTIFACT_KEY=
# Model, 45s timeout, 16000 input / 4000 output caps are pinned in ai-core; changing them requires review.
# OPENAI_MODEL and OPENAI_STORE_RESPONSES are informational legacy settings; adapter enforces pinned model/store:false.
RUN_REAL_AI_SMOKE=false
AI_SMOKE_SHARING_ACK=
AI_SMOKE_CONSENT_HASH=
AI_EVAL_HELDOUT_ACK=

# Explicit provider selection. Empty AI_MODEL uses that provider's reviewed default.
AI_PROVIDER=openai
AI_MODEL=
# Private restricted inference worker only. Never use a VITE_ prefix.
GEMINI_API_KEY=
# Leave false until account/region/billing/model access and Google terms are reviewed.
GEMINI_USAGE_CONFIRMED=false
# Gemini default: gemini-3.5-flash-lite, explicitly selected via ListModels.
# Legacy2.5 consent remains separate and keeps its 2026-12-01 cutoff.

# Phase 6 real refund execution remains disabled; mock accounts are configured separately.
PAYPAL_REFUNDS_ENABLED=false

# Container API binding (keep loopback for direct local development)
API_HOST=127.0.0.1
# Production rejects Sandbox/payment/refund enablement; no live activation is supported.
