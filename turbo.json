{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "WEB_ORIGIN",
    "API_PORT",
    "SESSION_HASH_PEPPER",
    "CSRF_SECRET",
    "VITE_API_BASE_URL",
    "API_PUBLIC_URL",
    "WORKER_DATABASE_URL",
    "PAYPAL_ENABLED",
    "PAYPAL_ENVIRONMENT",
    "PAYPAL_CLIENT_ID",
    "PAYPAL_CLIENT_SECRET",
    "PAYPAL_MERCHANT_ID",
    "PAYPAL_WEBHOOK_ID",
    "WEBHOOK_PAYLOAD_ENCRYPTION_KEY",
    "EVIDENCE_ENABLED",
    "EVIDENCE_DATABASE_URL",
    "CLAMAV_HOST",
    "CLAMAV_PORT",
    "AI_ENABLED",
    "AI_DATABASE_URL",
    "AI_ARTIFACT_KEY",
    "OPENAI_API_KEY",
    "AI_PROVIDER",
    "AI_MODEL",
    "GEMINI_USAGE_CONFIRMED"
  ]
}
